<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- Glowing red orb behind the icon -->
    <View
        android:id="@+id/alarmGlow"
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:background="@drawable/bg_alarm_glow"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/alarmTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.6" />

    <ImageView
        android:id="@+id/alarmEyeIcon"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@drawable/ic_eye_closed"
        app:tint="@color/alarm_red"
        app:layout_constraintTop_toTopOf="@id/alarmGlow"
        app:layout_constraintBottom_toBottomOf="@id/alarmGlow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/alarmTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="32dp"
        android:text="@string/wake_up"
        android:textColor="@color/white"
        android:textSize="52sp"
        android:textStyle="bold"
        android:gravity="center"
        android:letterSpacing="-0.02"
        app:layout_constraintBottom_toTopOf="@id/alarmSubtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/alarmSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="48dp"
        android:layout_marginBottom="56dp"
        android:text="@string/wake_up_subtitle"
        android:textColor="@color/text_secondary"
        android:textSize="16sp"
        android:gravity="center"
        android:lineSpacingMultiplier="1.4"
        app:layout_constraintBottom_toTopOf="@id/dismissButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/dismissButton"
        android:layout_width="0dp"
        android:layout_height="68dp"
        android:layout_marginHorizontal="28dp"
        android:layout_marginBottom="48dp"
        android:text="@string/im_awake"
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="@color/bg_dark"
        android:letterSpacing="0.01"
        app:backgroundTint="@color/alarm_red"
        app:cornerRadius="34dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
